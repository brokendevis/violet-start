{
  "name": "violet-start",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "pnpm format:check && pnpm typecheck && pnpm build && web-ext lint --source-dir dist",
    "package": "pnpm build && web-ext build --source-dir dist --artifacts-dir artifacts --filename violet-start-0.1.0.zip --overwrite-dest"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "web-ext": "^10.0.0"
  }
}
